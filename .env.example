POSTGRES_DB=fusionhcm360
POSTGRES_USER=fusionhcm
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://fusionhcm:change_me@localhost:5432/fusionhcm360

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/auth

# Frontend (Vite) — copy to frontend/.env.local
VITE_API_BASE_URL=http://localhost:8000

# Integration Center (local simulator). Secrets are process environment variables.
ALLOW_PRIVATE_INTEGRATION_TARGETS=False
INTEGRATION_CREDENTIAL_ENV_KEYS=[]
INTEGRATION_HTTP_TIMEOUT_SECONDS=5
INTEGRATION_MAX_ITEMS=100
# INTEGRATION_OUTPUT_DIR defaults to local-data/integrations

# AI assistant: mock runs without an external key. OpenAI is explicit opt-in.
AI_PROVIDER=mock
AI_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_API_KEY_ENV=OPENAI_API_KEY
AI_TEMPERATURE=0
AI_TIMEOUT_SECONDS=15
AI_MAX_TOKENS=500
AI_TOP_K=3
AI_MIN_SCORE=0.25
AI_DOCUMENT_MAX_BYTES=2097152
AI_QDRANT_URL=http://127.0.0.1:6333
AI_QDRANT_COLLECTION=fusionhcm_policies
# Set the named provider secret in the backend process environment; never in Vite.
